# Laravel Application Environment Configuration
# Docker Development Environment
# Copy this file to .env and adjust values for your local setup

# =
# Application Settings
# =
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=
ASSET_URL=
APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=

APP_MAINTENANCE_DRIVER=

BCRYPT_ROUNDS=

# =
# Logging Configuration
# =
LOG_CHANNEL=
LOG_STACK=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

# =
# Database Configuration (PostgreSQL 18)
# =
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# PostgreSQL Additional Settings
POSTGRES_INITDB_ARGS=

# =
# Session Configuration (Redis)
# =
SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=

# =
# Cache Configuration (Redis)
# =
CACHE_STORE=
CACHE_PREFIX=

# =
# Redis Configuration
# =
REDIS_CLIENT=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# =
# Queue Configuration
# =
QUEUE_CONNECTION=
QUEUE_FAILED_TABLE=

# =
# Real-time Notifications (Reverb WebSocket)
# =
BROADCAST_DRIVER=
BROADCAST_CONNECTION=

# =
# Mail Configuration (Optional)
# =
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# =
# AWS S3 Configuration (Optional)
# =
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

# =
# File Storage Configuration
# =
FILESYSTEM_DISK=

# =
# Miscellaneous Configuration
# =
MEMCACHED_HOST=

# Composer & Development
COMPOSER_ALLOW_SUPERUSER=

# Telescope (Debugging Tool - Optional)
TELESCOPE_ENABLED=

# Sanctum (API Authentication - Optional)
SANCTUM_STATEFUL_DOMAINS=

SEED_DATABASE=


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=

VITE_APP_NAME=
