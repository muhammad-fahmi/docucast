# Laravel Application Environment Configuration
# Docker Development Environment
# Copy this file to .env and adjust values for your local setup

# ==========================================
# Application Settings
# ==========================================
APP_NAME=DocuCast
APP_ENV=local
APP_KEY=base64:your_base64_encoded_key_here
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ==========================================
# Logging Configuration
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Database Configuration (PostgreSQL 18)
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docucast
DB_USERNAME=postgres
DB_PASSWORD=postgres

# PostgreSQL Additional Settings
POSTGRES_INITDB_ARGS="--locale=C --encoding=UTF8"

# ==========================================
# Session Configuration (Redis)
# ==========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# Cache Configuration (Redis)
# ==========================================
CACHE_STORE=redis
CACHE_PREFIX=docucast

# ==========================================
# Redis Configuration
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# ==========================================
# Queue Configuration
# ==========================================
QUEUE_CONNECTION=redis
QUEUE_FAILED_TABLE=failed_jobs

# ==========================================
# Real-time Notifications (Reverb WebSocket)
# ==========================================
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

# Reverb Server Configuration
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

# Reverb Application Keys
REVERB_APP_ID=docucast
REVERB_APP_KEY=docucast-app-key
REVERB_APP_SECRET=docucast-app-secret

# Vite Frontend Configuration - Reverb WebSocket
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=80
VITE_REVERB_SCHEME=http

# ==========================================
# Mail Configuration (Optional)
# ==========================================
MAIL_DRIVER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS S3 Configuration (Optional)
# ==========================================
AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=null
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# File Storage Configuration
# ==========================================
FILESYSTEM_DISK=local

# ==========================================
# Miscellaneous Configuration
# ==========================================
MEMCACHED_HOST=127.0.0.1

# Composer & Development
COMPOSER_ALLOW_SUPERUSER=1

# Telescope (Debugging Tool - Optional)
TELESCOPE_ENABLED=true

# Horizon (Queue Monitoring - Optional)
HORIZON_PATH=/horizon

# Sanctum (API Authentication - Optional)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,127.0.0.1

